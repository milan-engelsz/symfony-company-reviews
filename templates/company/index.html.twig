{% extends 'base.html.twig' %}

{% block title %}
    {{ 'nav.companies_statistics'|trans }}
{% endblock %}

{% block body %}
    <form action="{{ path('company.index') }}" method="GET">
        <div class="input-group">

            <input type="text" name="search" value="{{ search }}"
                   class="form-control "
                   placeholder="{{ 'placeholder.company_search'|trans }}"
            >
            <button class="btn btn-primary" type="submit">{{ 'action.search'|trans }}</button>
        </div>
    </form>

    <div class="table-responsive mt-5">
        <table class="table table-striped table-hover align-middle">
            <thead>
            <tr>
                <th>{{ 'pages.companies.index.rankColumn'|trans }}</th>
                <th>{{ 'pages.companies.index.companyName'|trans }}</th>
                <th class="text-center">{{ 'pages.companies.index.reviewCount'|trans }}</th>
                <th class="text-center">{{ 'pages.companies.index.avgRating'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for stat in companyNamesWithStatistics %}
                <tr>
                    <td>{{ loop.index }}.</td>
                    <td class="fw-bold">{{ stat.companyName }}</td>
                    <td class="text-center">{{ stat.reviewCount }} {{ 'pages.companies.index.unitPieces'|trans }}</td>
                    <td class="text-center">
                        {{ stat.avgRating|number_format(2, ',', ' ') }}
                        <i class="bi bi-star-fill"></i>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        {{ 'empty_state.companies'|trans }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
